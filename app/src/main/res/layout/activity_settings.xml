<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fond_sombre">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- En-tete, meme style que l'ecran principal -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/degrade_entete"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingTop="14dp"
            android:paddingBottom="14dp">

            <ImageButton
                android:id="@+id/boutonRetour"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@android:color/transparent"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                android:contentDescription="Retour"
                app:tint="@color/texte_clair" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:text="Paramètres"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/texte_clair" />

        </LinearLayout>

        <!-- Carte : taille de la zone d'analyse -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="6dp"
            app:cardBackgroundColor="@color/carte_blanc">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Taille de la zone d'analyse"
                    android:textColor="@color/texte_principal"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Plus petite pour les chutes minuscules (brims, jupes), plus grande pour les grosses pièces."
                    android:textColor="@color/texte_secondaire"
                    android:textSize="13sp" />

                <RadioGroup
                    android:id="@+id/groupeTailleReticule"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp">

                    <RadioButton
                        android:id="@+id/optionPetit"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Petit (pièces minuscules)" />

                    <RadioButton
                        android:id="@+id/optionMoyen"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Moyen (par défaut)" />

                    <RadioButton
                        android:id="@+id/optionGrand"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Grand (grosses pièces)" />

                </RadioGroup>

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- Carte : delai de calibration -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="6dp"
            app:cardBackgroundColor="@color/carte_blanc">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Délai avant recalibration"
                    android:textColor="@color/texte_principal"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Plus court si ton éclairage change souvent, plus long s'il reste stable."
                    android:textColor="@color/texte_secondaire"
                    android:textSize="13sp" />

                <RadioGroup
                    android:id="@+id/groupeDelaiCalibration"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp">

                    <RadioButton
                        android:id="@+id/optionDelai30"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="30 minutes" />

                    <RadioButton
                        android:id="@+id/optionDelai60"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="1 heure (par défaut)" />

                    <RadioButton
                        android:id="@+id/optionDelai120"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="2 heures" />

                </RadioGroup>

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- Carte : vibration -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="6dp"
            app:cardBackgroundColor="@color/carte_blanc">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Vibration sur lecture stable"
                        android:textColor="@color/texte_principal"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <Switch
                        android:id="@+id/interrupteurVibration"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Rapidité de déclenchement"
                    android:textColor="@color/texte_secondaire"
                    android:textSize="13sp" />

                <RadioGroup
                    android:id="@+id/groupeSeuilVibration"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp">

                    <RadioButton
                        android:id="@+id/optionVibrationRapide"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Rapide" />

                    <RadioButton
                        android:id="@+id/optionVibrationNormale"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Normale (par défaut)" />

                    <RadioButton
                        android:id="@+id/optionVibrationLente"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Lente (plus sûre)" />

                </RadioGroup>

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- Carte : bon a savoir -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="6dp"
            app:cardBackgroundColor="@color/carte_blanc">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Bon à savoir"
                    android:textColor="@color/texte_principal"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Recalibre manuellement (icône cible) si tu changes de fond de travail, si tu allumes/éteins la torche, ou si l'éclairage change nettement — pas la peine d'attendre le délai automatique."
                    android:textColor="@color/texte_secondaire"
                    android:textSize="13sp" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- Carte : a propos -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="6dp"
            app:cardBackgroundColor="@color/carte_blanc">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="À propos"
                    android:textColor="@color/texte_principal"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/texteVersion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="DaltonEye"
                    android:textColor="@color/texte_secondaire"
                    android:textSize="14sp" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- Bouton copier infos de diagnostic -->
        <Button
            android:id="@+id/boutonDiagnostic"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="12dp"
            android:text="Copier les infos de diagnostic"
            android:textAllCaps="false"
            android:textColor="@color/texte_clair"
            android:background="@drawable/fond_bouton_calibrer" />

        <!-- Bouton reinitialiser -->
        <Button
            android:id="@+id/boutonReinitialiser"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="24dp"
            android:text="Réinitialiser les paramètres"
            android:textAllCaps="false"
            android:textColor="@color/attention"
            android:background="@android:color/transparent" />

    </LinearLayout>

</ScrollView>
