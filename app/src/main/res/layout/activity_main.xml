<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fond_sombre">

    <!-- En-tete degrade avec logo et nom de l'appli -->
    <LinearLayout
        android:id="@+id/entete"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/degrade_entete"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="14dp"
        android:paddingBottom="14dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:src="@mipmap/ic_launcher"
            android:contentDescription="Logo DaltonEye" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="DaltonEye"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/texte_clair" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/texteCompteACalibration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:textColor="@color/texte_clair"
            android:textSize="13sp"
            android:text="" />

        <ImageButton
            android:id="@+id/boutonCalibrerManuel"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@android:color/transparent"
            android:src="@drawable/ic_calibrer"
            android:contentDescription="Calibrer maintenant"
            app:tint="@color/texte_clair" />

    </LinearLayout>

    <!-- Flux camera en direct, dans un cadre visuel -->
    <androidx.camera.view.PreviewView
        android:id="@+id/previewCamera"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/fond_camera"
        app:layout_constraintTop_toBottomOf="@id/entete"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/carteResultat" />

    <!-- Reticule colore au centre de l'ecran pour indiquer la zone analysee -->
    <View
        android:id="@+id/reticule"
        android:layout_width="90dp"
        android:layout_height="90dp"
        android:background="@drawable/reticule_zone"
        app:layout_constraintTop_toTopOf="@id/previewCamera"
        app:layout_constraintBottom_toBottomOf="@id/previewCamera"
        app:layout_constraintStart_toStartOf="@id/previewCamera"
        app:layout_constraintEnd_toEndOf="@id/previewCamera" />

    <!-- Carte flottante en bas : accent colore + apercu de la couleur captee + nom de la famille -->
    <androidx.cardview.widget.CardView
        android:id="@+id/carteResultat"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:cardCornerRadius="24dp"
        app:cardElevation="12dp"
        app:cardBackgroundColor="@color/carte_blanc"
        app:cardPreventCornerOverlap="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Bandeau accent, tinte dynamiquement avec la couleur de la famille detectee -->
            <View
                android:id="@+id/barreAccentResultat"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:background="@color/daltoneye_cyan" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="22dp">

                <!-- Apercu brut de la couleur captee par le telephone -->
                <View
                    android:id="@+id/carreCouleurCaptee"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:background="@drawable/forme_couleur_captee" />

                <TextView
                    android:id="@+id/nomFamilleCouleur"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="20dp"
                    android:text="—"
                    android:textColor="@color/texte_principal"
                    android:textSize="30sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/texteHexCapte"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="#000000"
                    android:textColor="@color/texte_secondaire"
                    android:textSize="12sp"
                    android:fontFamily="monospace" />

                <TextView
                    android:id="@+id/badgeFige"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Figé"
                    android:textColor="@color/texte_clair"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:background="@drawable/fond_badge_fige"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:visibility="gone" />

            </LinearLayout>

        </LinearLayout>

    </androidx.cardview.widget.CardView>

    <!-- Ecran de calibration, cache par defaut, bloquant quand affiche -->
    <include
        android:id="@+id/ecranCalibration"
        layout="@layout/vue_calibration"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
