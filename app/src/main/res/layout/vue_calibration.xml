<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/racineCalibration"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#CC12141A">

    <androidx.cardview.widget.CardView
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        app:cardCornerRadius="24dp"
        app:cardElevation="16dp"
        app:cardBackgroundColor="@color/carte_blanc"
        xmlns:app="http://schemas.android.com/apk/res-auto">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <View
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:background="@drawable/degrade_entete" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="28dp">

                <TextView
                    android:id="@+id/titreCalibration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Calibration nécessaire"
                    android:textColor="@color/texte_principal"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:gravity="center" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Pointe l'appareil vers une feuille blanche ou un objet neutre, bien éclairé, puis valide."
                    android:textColor="@color/texte_secondaire"
                    android:textSize="14sp"
                    android:gravity="center" />

                <Button
                    android:id="@+id/boutonCalibrer"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="22dp"
                    android:background="@drawable/fond_bouton_calibrer"
                    android:text="Calibrer sur ce blanc"
                    android:textAllCaps="false"
                    android:textColor="@color/texte_clair"
                    android:textSize="15sp" />

            </LinearLayout>

        </LinearLayout>

    </androidx.cardview.widget.CardView>

</FrameLayout>
